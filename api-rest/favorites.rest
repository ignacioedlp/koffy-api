@baseUrl = http://localhost:3000
@token = YOUR_AUTH_TOKEN_HERE

### Get all favorites (paginated)
GET {{baseUrl}}/favorites
Authorization: Bearer {{token}}

### Get all favorites with pagination parameters
GET {{baseUrl}}/favorites?page=1&per_page=10
Authorization: Bearer {{token}}

### Get favorites filtered by type (coffee)
GET {{baseUrl}}/favorites?type=coffee
Authorization: Bearer {{token}}

### Get favorites filtered by type (roaster)
GET {{baseUrl}}/favorites?type=roaster
Authorization: Bearer {{token}}

### Get favorites filtered by type (coffee_variant)
GET {{baseUrl}}/favorites?type=coffee_variant
Authorization: Bearer {{token}}

### Get favorites with type filter and pagination
GET {{baseUrl}}/favorites?type=coffee&page=1&per_page=5
Authorization: Bearer {{token}}

### Create a favorite for a Coffee
POST {{baseUrl}}/favorites
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "favorite": {
    "favoritable_type": "Coffee",
    "favoritable_id": 1
  }
}

### Create a favorite for a Roaster
POST {{baseUrl}}/favorites
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "favorite": {
    "favoritable_type": "Roaster",
    "favoritable_id": 1
  }
}

### Create a favorite for a CoffeeVariant
POST {{baseUrl}}/favorites
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "favorite": {
    "favoritable_type": "CoffeeVariant",
    "favoritable_id": 1
  }
}

### Delete a favorite by ID
DELETE {{baseUrl}}/favorites/1
Authorization: Bearer {{token}}

### Delete a favorite by favoritable type and ID (alternative method)
DELETE {{baseUrl}}/favorites/remove?favoritable_type=Coffee&favoritable_id=1
Authorization: Bearer {{token}}
